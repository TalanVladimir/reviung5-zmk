#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/mouse.h>

#define BASE 0
#define TRACK 1

/ {

  macros {
    use_reserve: use_reserve {
        label = "ZM_use_reserve";
        compatible = "zmk,behavior-macro";
        #binding-cells = <0>;
        bindings
                = <&macro_tap &kp LC(C)>
                , <&macro_wait_time 100>
                , <&macro_tap &kp UP>
                , <&macro_wait_time 100>
                , <&macro_tap &kp LC(V)>
                , <&macro_wait_time 100>
                , <&macro_tap &kp LC(C)>
                , <&macro_wait_time 100>
                , <&macro_tap &kp LEFT &kp LEFT &kp LEFT &kp LEFT &kp LEFT>
                , <&macro_wait_time 100>
                , <&macro_tap &kp LC(LS(V))>
                , <&macro_wait_time 100>
                , <&macro_tap &kp LC(LS(R))>
                , <&macro_wait_time 100>
                , <&macro_tap &kp DOWN>
                , <&macro_wait_time 500>
                , <&macro_tap &kp LS(SPACE)>
                , <&macro_wait_time 500>
                , <&macro_tap &kp LC(KP_MINUS)>;
    };
  };

  keymap {
      compatible = "zmk,keymap";

      base_layer {
        label = "BASE";
        bindings = <
          // ╭────────────────┬──────────────┬────────────────────────┬──────────────┬────────────╮
               &kp C_PREVIOUS   &kp C_VOL_DN   &lt TRACK C_PLAY_PAUSE   &kp C_VOL_UP   &kp C_NEXT
          // ╰────────────────┴──────────────┴────────────────────────┴──────────────┴────────────╯
        >;
      };

      track_layer {
        label = "TRACK";
        bindings = <
          // ╭───────┬──────────┬────────┬───────────┬─────────╮
               &kp F   &kp LEFT   &trans   &kp RIGHT   &use_reserve
          // ╰───────┴──────────┴────────┴───────────┴─────────╯
        >;
      };
  };
};
