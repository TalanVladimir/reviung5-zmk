#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/mouse.h>

#define BASE 0
#define TRACK 1
#define BLE 2

/ {

  macros {
          #include "os/macros.keymap"
  };

  keymap {
      compatible = "zmk,keymap";

      base_layer {
        label = "BASE";
        bindings = <
          // ╭────────────────┬──────────────┬────────────────────────┬──────────────┬────────────╮
               &kp C_PREVIOUS   &kp C_VOL_DN   &lt TRACK C_PLAY_PAUSE   &kp C_VOL_UP   &kp C_NEXT
          // ╰────────────────┴──────────────┴────────────────────────┴──────────────┴────────────╯
        >;
      };

      track_layer {
        label = "TRACK";
        bindings = <
          // ╭───────┬──────────┬────────┬───────────┬─────────╮
               &kp F   &kp LEFT   &trans   &kp RIGHT   &use_reserve
          // ╰───────┴──────────┴────────┴───────────┴─────────╯
        >;
      };

      ble_layer {
        label = "BLE";
        bindings = <
          // ╭───────────┬──────────────┬──────────────┬──────────────┬────────╮
               &trans      &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &trans
          // ╰───────────┴──────────────┴──────────────┴──────────────┴────────╯
        >;
      };
  };
};
